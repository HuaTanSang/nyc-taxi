# Runtime-only template. Keep real values in a restricted .env outside images/Git.
DATABRICKS_HOST=https://adb-REPLACE.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/REPLACE
DATABRICKS_CATALOG=nyc_taxi
DATABRICKS_SCHEMA=

# Pipeline principal: Airflow/Cosmos/dbt.
DATABRICKS_CLIENT_ID=
DBT_ENV_SECRET_DATABRICKS_CLIENT_SECRET=

# Separate read-only Superset principal.
DATABRICKS_SUPERSET_CLIENT_ID=
DATABRICKS_SUPERSET_CLIENT_SECRET=

AIRFLOW_FERNET_KEY=
AIRFLOW_API_JWT_SECRET=
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_POSTGRES_DB=airflow
SUPERSET_SECRET_KEY=
SUPERSET_POSTGRES_USER=superset
SUPERSET_POSTGRES_PASSWORD=
SUPERSET_POSTGRES_DB=superset
