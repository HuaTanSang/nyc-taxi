FROM apache/airflow:slim-3.2.2-python3.12

USER airflow
COPY --chown=airflow:root src/airflow/airflow-requirements.txt /tmp/airflow-requirements.txt
COPY --chown=airflow:root src/dbt/dbt-requirements.txt /tmp/dbt-requirements.txt
RUN pip install --no-cache-dir \
    --requirement /tmp/airflow-requirements.txt \
    --requirement /tmp/dbt-requirements.txt \
    && pip check \
    && mkdir -p /opt/airflow/dags

COPY --chown=airflow:root src/dbt /opt/airflow/dbt

ENV DBT_PROFILES_DIR=/opt/airflow/dbt \
    DBT_SEND_ANONYMOUS_USAGE_STATS=false \
    AIRFLOW__CORE__LOAD_EXAMPLES=false \
    AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
WORKDIR /opt/airflow
