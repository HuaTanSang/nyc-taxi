FROM ghcr.io/astral-sh/uv:0.7.21 AS uv

FROM apache/airflow:3.2.2-python3.12

USER root

COPY --from=uv /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/airflow

COPY --chown=airflow:root \
    src/airflow/airflow-requirements.txt \
    /tmp/airflow-requirements.txt
COPY --chown=airflow:root \
    src/dbt/dbt-requirements.txt \
    /tmp/dbt-requirements.txt

RUN uv pip install \
    --system \
    --no-cache \
    --requirement /tmp/airflow-requirements.txt \
    --requirement /tmp/dbt-requirements.txt

COPY --chown=airflow:root src/dbt /opt/airflow/dbt

USER airflow

ENV DBT_PROFILES_DIR=/opt/airflow/dbt

WORKDIR /opt/airflow/dbt

RUN dbt deps \
    && dbt parse \
    && test -d dbt_packages/dbt_utils \
    && test -f target/manifest.json

WORKDIR /opt/airflow
