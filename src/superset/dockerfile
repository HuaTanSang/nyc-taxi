FROM apache/superset:6.0.0

USER root
COPY src/superset/superset-requirements.txt /tmp/superset-requirements.txt
RUN uv pip install --python /app/.venv/bin/python --no-cache \
    --requirement /tmp/superset-requirements.txt \
    && uv pip check --python /app/.venv/bin/python
COPY --chown=superset:superset src/superset/superset_config.py /app/pythonpath/superset_config.py
COPY --chown=superset:superset src/superset/databricks_auth.py /app/pythonpath/databricks_auth.py
ENV SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py
USER superset
